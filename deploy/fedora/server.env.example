THOUGHTS_DATABASE_URL=postgresql+psycopg:///thoughts
THOUGHTS_STATE_ROOT=/srv/thoughts/state
THOUGHTS_SOURCE_BUNDLE_OUTPUT=/srv/thoughts/state/source-bundle
THOUGHTS_OBJECT_ROOT=/srv/thoughts/objects
THOUGHTS_WORKTREE_ROOT=/srv/thoughts/worktree
THOUGHTS_DOCS_ROOT=/srv/thoughts/worktree
THOUGHTS_API_HOST=127.0.0.1
THOUGHTS_API_PORT=8080
# Public origin for links the server emits: this server's HTTPS address
# (configure-public-https.sh sets it to its --public-host).
THOUGHTS_PUBLIC_BASE_URL=https://thoughts.example.org
# Failed bearer authentication per client address: 10 wrong tokens in 300 s
# block that address for 900 s.  A request without a token is refused but not
# counted.  During a block, a token that worked from that address within the
# last day is still accepted, so one misbehaving client does not lock out the
# devices beside it.  THOUGHTS_AUTH_FAILURE_LIMIT=0 disables the limit.
# THOUGHTS_AUTH_FAILURE_LIMIT=10
# THOUGHTS_AUTH_FAILURE_WINDOW_SECONDS=300
# THOUGHTS_AUTH_LOCKOUT_SECONDS=900
# THOUGHTS_AUTH_TRACKED_CLIENTS=10000
# Agent-proposal decisions (protocol/agent-proposals.md 10.7.1). Off: a hand edit that is
# exactly an accept or reject still retires the proposal. Turn on only after desktop, phone
# and VS Code builds that send decision claims are installed.
# THOUGHTS_PROPOSAL_DECISIONS_STRICT=false
# The interactive API documentation (/docs, /redoc) and /openapi.json are public
# pages.  Keep them off on a server that others can reach.
THOUGHTS_API_DOCS=false
THOUGHTS_WORKER_POLL_SECONDS=1
# A build that runs longer is stopped, so one document cannot hold a Library's
# build worker for hours. 15 minutes is far above a normal build (seconds to a
# few minutes); raise it only for a Library with unusually long full rebuilds.
THOUGHTS_BUILD_TIMEOUT_SECONDS=900
THOUGHTS_MAX_OBJECT_BYTES=536870912
THOUGHTS_TOOLCHAIN_KEY=fedora-asahi-unconfigured
THOUGHTS_ALLOW_DEVELOPMENT_BUILDS=false
THOUGHTS_AUTO_CREATE_SCHEMA=false
THOUGHTS_RENDERER_BACKEND=native
# Documents compile in a bubblewrap sandbox (no network, no other Library's files,
# no server configuration). This is the default on Linux. Setting it to false turns
# the sandbox off for the default Library only and is discouraged: use it only on
# a server whose single user is its operator.
# THOUGHTS_SANDBOX_BUILDS=true
THOUGHTS_REVIEW_AGENT_MODEL=gpt-5.6-sol
THOUGHTS_REVIEW_AGENT_REASONING_EFFORT=high
THOUGHTS_REVIEW_AGENT_TIMEOUT_SECONDS=900
THOUGHTS_REVIEW_REANCHOR_MAX_ATTEMPTS=3
# OPENAI_API_KEY=
# Old MJ PDF Reader notes without a creator are attributed to that app only when
# their author is this name (the reader's former default author). Unset: never.
# THOUGHTS_LEGACY_MJ_PDF_AUTHOR=
THOUGHTS_COMMENT_SYNC_BIN=/srv/thoughts/bin/thoughts-comment-sync
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD_FILE=/etc/thoughts/restic-password
# RESTIC_REST_USERNAME=fedora
# RESTIC_REST_PASSWORD=
