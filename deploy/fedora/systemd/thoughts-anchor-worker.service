[Unit]
Description=Thoughts annotation anchor worker
After=network-online.target postgresql.service thoughts-api.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=thoughts
Group=thoughts
WorkingDirectory=/srv/thoughts/app
EnvironmentFile=/etc/thoughts/server.env
Environment=XDG_DATA_HOME=/srv/thoughts/state/xdg-data
ExecStart=/srv/thoughts/venv/bin/thoughts-anchor-worker
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/srv/thoughts/objects /srv/thoughts/state /srv/thoughts/worktree -/srv/thoughts/libraries
# Resource limits (see thoughts-api.service): anchoring reads PDFs page by page.
CPUWeight=50
MemoryMax=2G
MemorySwapMax=512M
OOMPolicy=continue
TasksMax=512

[Install]
WantedBy=multi-user.target
