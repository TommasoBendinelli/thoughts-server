[Unit]
Description=Thoughts combined PDF export worker
# Explicit exports run separately from document builds and Sync.
After=network-online.target postgresql.service thoughts-api.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=thoughts
Group=thoughts
WorkingDirectory=/srv/thoughts/app
EnvironmentFile=/etc/thoughts/server.env
Environment=XDG_DATA_HOME=/srv/thoughts/state/xdg-data
ExecStart=/srv/thoughts/venv/bin/thoughts-export-worker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
# Exports write only private staging and content-addressed objects.
ReadWritePaths=/srv/thoughts/objects /srv/thoughts/state /srv/thoughts/worktree -/srv/thoughts/libraries
# Resource limits (see thoughts-api.service): exports merge PDFs in memory and
# give way to interactive work.
CPUWeight=50
MemoryMax=3G
MemorySwapMax=1G
OOMPolicy=continue
TasksMax=512

[Install]
WantedBy=multi-user.target