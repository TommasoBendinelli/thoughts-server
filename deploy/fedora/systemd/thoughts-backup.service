[Unit]
Description=Back up Thoughts PostgreSQL and immutable objects
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=thoughts
Group=thoughts
EnvironmentFile=/etc/thoughts/server.env
ExecStart=/usr/local/sbin/thoughts-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
# Resource limits (see thoughts-api.service). The memory ceiling is generous:
# restic's needs grow with the repository, and a backup must not fail for it.
CPUWeight=20
MemoryMax=4G
TasksMax=512
