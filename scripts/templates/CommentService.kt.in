            ?: return CommentResult(false, "Comment history is unavailable")
        val current = load().associateBy { it.id }
        val timestamp = clock()
        val changes = entry.changes.map { original ->
            val record = current[original.before.id]
                ?: return CommentResult(false, "Comment is unavailable: ${original.before.id}")
            if (record.deleted() != undoing) return CommentResult(false, "Comment changed since this history action")
            CommentChange(record, changed(record, !undoing, timestamp))
        }
        val result = apply(changes)
        entry.undone = undoing
        return result.copy(historyToken = token)
    }
    private fun CommentRecord.deleted(): Boolean = payload.get("deleted")?.asBoolean == true
