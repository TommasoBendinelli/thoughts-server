    private data class History(val changes: List<CommentChange>, var undone: Boolean = false)
    private val history = mutableMapOf<Int, History>()
    private var nextToken = 0

    suspend fun deleteComments(ids: List<String>): CommentResult {
        val records = load()
        val byId = records.associateBy { it.id }
        if (byId.size != records.size) return CommentResult(false, "Duplicate comment identity")
        ids.firstOrNull { it !in byId }?.let { return CommentResult(false, "Comment is unavailable: $it") }
        val selected = ids.toMutableSet()
        do {
            var expanded = false
            for (record in records) {
                if (record.parentId.isNotBlank() && record.parentId in selected && selected.add(record.id)) expanded = true
            }
        } while (expanded)
        val timestamp = clock()
        val ordered = (ids + records.map { it.id }).distinct().map { byId.getValue(it) }
        val changes = ordered.filter { it.id in selected && !it.deleted() }
            .map { CommentChange(it, changed(it, true, timestamp)) }
        val result = apply(changes)
        return if (!result.success || changes.isEmpty()) result else {
            val token = ++nextToken
            history[token] = History(changes)
            result.copy(historyToken = token)
        }
    }
    suspend fun undo(token: Int): CommentResult = restore(token, true)
