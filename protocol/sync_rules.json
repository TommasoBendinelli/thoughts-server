{
  "version": 1,
  "source_rules": [
    {
      "when": {
        "same_contents": true
      },
      "action": "acknowledge",
      "reason": "local_matches_remote"
    },
    {
      "when": {
        "local_exists": false,
        "absence_is_deletion": false
      },
      "action": "install_remote",
      "reason": "restore_evicted_source"
    },
    {
      "when": {
        "base_known": false,
        "local_exists": false
      },
      "action": "install_remote",
      "reason": "new_remote_source"
    },
    {
      "when": {
        "base_known": false
      },
      "action": "needs_attention",
      "reason": "missing_merge_base"
    },
    {
      "when": {
        "local_matches_base": true
      },
      "action": "install_remote",
      "reason": "remote_only_change"
    },
    {
      "when": {
        "remote_matches_base": true
      },
      "action": "publish_local",
      "reason": "local_only_change"
    },
    {
      "when": {},
      "action": "merge",
      "reason": "both_sides_changed"
    }
  ],
  "sync_rules": [
    {
      "when": {
        "authoring_checked": false
      },
      "action": "reconcile_sources",
      "reason": "editable_source_checkpoint_behind"
    },
    {
      "when": {
        "logical_pending": true
      },
      "action": "upload_operations",
      "reason": "local_operations_pending"
    },
    {
      "when": {
        "sources_pending": true
      },
      "action": "publish_sources",
      "reason": "local_sources_pending"
    },
    {
      "when": {
        "build_needed": true
      },
      "action": "build_affected",
      "reason": "render_inputs_changed"
    },
    {
      "when": {
        "artifacts_current": false
      },
      "action": "activate_artifacts",
      "reason": "reader_publication_behind"
    },
    {
      "when": {
        "documents_blocked": true
      },
      "action": "needs_attention",
      "reason": "some_documents_blocked"
    },
    {
      "when": {},
      "action": "complete",
      "reason": "captured_state_acknowledged"
    }
  ]
}
